---
interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="War Inc: Rising Wiki" />
    {image && <meta property="og:image" content={image} />}

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": title,
      "description": description,
      "url": canonical,
      "isPartOf": {
        "@type": "WebSite",
        "name": "War Inc: Rising Wiki",
        "url": "https://war-inc-rising.codex-atlas.com",
      },
    })}></script>
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; line-height: 1.6; color: #1a1a2e; background: #f8f9fa; padding: 1rem; }
      header { border-bottom: 1px solid #e0e0e0; padding-bottom: 0.75rem; margin-bottom: 1.5rem; }
      header nav { display: flex; gap: 1.5rem; flex-wrap: wrap; }
      header nav a { color: #e94560; text-decoration: none; font-weight: 600; }
      header nav a:hover { text-decoration: underline; }
      main { max-width: 960px; margin: 0 auto; }
      h1 { font-size: 1.75rem; margin-bottom: 0.5rem; color: #1a1a2e; }
      h2 { font-size: 1.25rem; margin: 1.5rem 0 0.5rem; color: #16213e; }
      h3 { font-size: 1.1rem; margin: 1rem 0 0.25rem; }
      p { margin-bottom: 0.75rem; }
      a { color: #0f3460; }
      a:hover { color: #e94560; }
      table { width: 100%; border-collapse: collapse; margin: 1rem 0; }
      th, td { border: 1px solid #dee2e6; padding: 0.4rem 0.6rem; text-align: left; }
      th { background: #e9ecef; font-weight: 600; }
      tr:nth-child(even) { background: #f8f9fa; }
      ul, ol { margin: 0.5rem 0 1rem 1.5rem; }
      li { margin-bottom: 0.25rem; }
      footer { border-top: 1px solid #e0e0e0; padding-top: 0.75rem; margin-top: 2rem; color: #6c757d; font-size: 0.875rem; }
      [aria-label="Breadcrumb"] { font-size: 0.875rem; color: #6c757d; margin-bottom: 1rem; }
      [aria-label="Breadcrumb"] a { color: #6c757d; }
      .rarity { display: inline-block; padding: 0.1rem 0.4rem; border-radius: 3px; font-size: 0.8rem; background: #e9ecef; }
      .meta { color: #6c757d; font-size: 0.875rem; }
    </style>
  </head>
  <body>
    <header>
      <nav>
        <a href="/">War Inc: Rising Wiki</a>
        <a href="/heroes/">Heroes</a>
        <a href="/bosses/">Bosses</a>
        <a href="/tools/">Tools</a>
        <a href="/resources/">Resources</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>War Inc: Rising Wiki — Unofficial fan site. Data sourced from the game APK.</p>
    </footer>
  </body>
</html>
