---
import BaseLayout from '../../layouts/BaseLayout.astro';

const files = import.meta.glob('/data/pages/modes/_index.json', { eager: true, import: 'default' });
const index = files['/data/pages/modes/_index.json'] ?? { items: [], count: 0 };
const items = index.items ?? [];
---

<BaseLayout
  title="Game Modes - Rules, Rewards, and Strategy | War Inc: Rising"
  description={`Learn about all ${items.length} game modes in War Inc: Rising.`}
  currentSection="guides"
>
  <nav class="breadcrumb">
    <a href="/">Home</a>
    <span class="breadcrumb-sep">›</span>
    <span>Game Modes</span>
  </nav>
  <h1>Game Modes</h1>
  <p>{items.length} modes with different rules, enemy pools, and rewards.</p>
  <ul class="listing-grid">
    {items.map((item) => (
      <li><a href={`/modes/${item.slug}/`} class="card card-pad-md card-hoverable" style="display:block;text-decoration:none;color:inherit;"><strong>{item.name}</strong></a></li>
    ))}
  </ul>
</BaseLayout>
