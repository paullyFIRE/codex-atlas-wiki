---
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const pages = import.meta.glob('/data/pages/modes/*.json', { eager: true, import: 'default' });
  const index = pages['/data/pages/modes/_index.json'];
  const items = index?.items ?? [];
  return items.map((item) => ({
    params: { slug: item.slug },
    props: { slug: item.slug },
  }));
}

const { slug } = Astro.params;

const files = import.meta.glob('/data/pages/modes/*.json', { eager: true, import: 'default' });
const pageData = files[`/data/pages/modes/${slug}.json`];
if (!pageData) return Astro.redirect('/modes/', 404);
---

<BaseLayout title={pageData.title} description={pageData.meta_description}>
  <script type="application/ld+json" set:html={JSON.stringify(pageData.schema)} />

  <nav aria-label="Breadcrumb">
    <a href="/">Home</a> &gt; <a href="/modes/">Game Modes</a> &gt; <span>{pageData.name}</span>
  </nav>

  <article>
    <header>
      <h1>{pageData.name}</h1>
    </header>

    <section>
      <h2>Overview</h2>
      <p>Layout ID: {pageData.layout_id}</p>
      <p>Mini-game cycle: {pageData.mini_game_rule?.cycle}</p>

      <h2>Rewards</h2>
      {pageData.rewards.length > 0 ? (
        <ul>
          {pageData.rewards.map((r) => (
            <li>Type {r.type} × {r.count}</li>
          ))}
        </ul>
      ) : (
        <p>No reward data available.</p>
      )}
    </section>
  </article>
</BaseLayout>
