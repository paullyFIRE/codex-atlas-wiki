---
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const pages = import.meta.glob('/data/pages/modes/*.json', { eager: true, import: 'default' });
  const index = pages['/data/pages/modes/_index.json'];
  const items = index?.items ?? [];
  return items.map((item) => ({
    params: { slug: item.slug },
    props: { slug: item.slug },
  }));
}

const { slug } = Astro.params;

const files = import.meta.glob('/data/pages/modes/*.json', { eager: true, import: 'default' });
const pageData = files[`/data/pages/modes/${slug}.json`];
if (!pageData) return Astro.redirect('/modes/', 404);
---

<BaseLayout title={pageData.title} description={pageData.meta_description}>
  <script type="application/ld+json" set:html={JSON.stringify(pageData.schema)} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://war-inc-rising.codex-atlas.com/" },
      { "@type": "ListItem", "position": 2, "name": "Game Modes", "item": "https://war-inc-rising.codex-atlas.com/modes/" },
      { "@type": "ListItem", "position": 3, "name": pageData.name }
    ]
  })} />

  <nav class="flex items-center gap-2 text-label-md font-bold text-on-surface-variant mb-8 uppercase tracking-wider">
    <a href="/" class="hover:text-primary no-underline">Home</a>
    <span class="material-symbols-outlined text-xs">chevron_right</span>
    <a href="/modes/" class="hover:text-primary no-underline">Game Modes</a>
    <span class="material-symbols-outlined text-xs">chevron_right</span>
    <span class="text-primary bg-primary-container/20 px-3 py-1 rounded-full">{pageData.name}</span>
  </nav>

  <article>
    <header>
      <h1>{pageData.name}</h1>
    </header>

    <section>
      <h2>Overview</h2>
      <p>Layout ID: {pageData.layout_id}</p>
      <p>Mini-game cycle: {pageData.mini_game_rule?.cycle}</p>

      <h2>Rewards</h2>
      {pageData.rewards.length > 0 ? (
        <ul>
          {pageData.rewards.map((r) => (
            <li>Type {r.type} × {r.count}</li>
          ))}
        </ul>
      ) : (
        <p>No reward data available.</p>
      )}
    </section>
  </article>
</BaseLayout>
