---
import BaseLayout from '../layouts/BaseLayout.astro';

const siteTitle = 'War Inc: Rising Wiki | war-inc-rising.codex-atlas.com';
const siteDescription = 'Comprehensive War Inc: Rising wiki — hero stats, skills, equipment, and strategy guides for all game modes.';

const heroIdx = import.meta.glob('/data/pages/heroes/_index.json', { eager: true, import: 'default' });
const buildIdx = import.meta.glob('/data/pages/buildings/_index.json', { eager: true, import: 'default' });
const buffIdx = import.meta.glob('/data/pages/buffs/_index.json', { eager: true, import: 'default' });
const synIdx = import.meta.glob('/data/pages/synergies/_index.json', { eager: true, import: 'default' });
const modeIdx = import.meta.glob('/data/pages/modes/_index.json', { eager: true, import: 'default' });
const followIdx = import.meta.glob('/data/pages/followers/_index.json', { eager: true, import: 'default' });
const heroCount = heroIdx['/data/pages/heroes/_index.json']?.count ?? 0;
const buildingCount = buildIdx['/data/pages/buildings/_index.json']?.count ?? 0;
const buffCount = buffIdx['/data/pages/buffs/_index.json']?.count ?? 0;
const synCount = synIdx['/data/pages/synergies/_index.json']?.count ?? 0;
const modeCount = modeIdx['/data/pages/modes/_index.json']?.count ?? 0;
const followerCount = followIdx['/data/pages/followers/_index.json']?.count ?? 0;
---

<BaseLayout title={siteTitle} description={siteDescription}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "VideoGame",
    "name": "War Inc: Rising",
    "applicationCategory": "Game",
    "operatingSystem": "Android",
    "author": { "@type": "Organization", "name": "Fastone Games" },
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "war-inc-rising.codex-atlas.com",
    "url": "https://war-inc-rising.codex-atlas.com",
    "description": "War Inc: Rising wiki with hero stats, skills, equipment data, and strategy guides.",
  })} />

  <h1>War Inc: Rising Wiki</h1>
  <p>{siteDescription}</p>

  <div class="card card-pad-lg" style="margin-bottom: var(--space-6);">
    <h2 style="margin-top: 0;">Browse by Category</h2>
    <ul class="quick-links">
      <li><a href="/heroes/"><strong>All Heroes</strong> — {heroCount} playable units</a></li>
      <li><a href="/buildings/"><strong>Buildings</strong> — {buildingCount} structures</a></li>
      <li><a href="/hunting-bosses/"><strong>Hunting Mode Bosses</strong> — 20 enemies</a></li>
      <li><a href="/followers/"><strong>Followers</strong> — {followerCount} pets & troops</a></li>
      <li><a href="/modes/"><strong>Game Modes</strong> — {modeCount} configurations</a></li>
      <li><a href="/synergies/"><strong>Synergies</strong> — {synCount} team bonuses</a></li>
      <li><a href="/buffs/"><strong>Field Buffs</strong> — {buffCount} modifiers</a></li>
    </ul>
  </div>

  <div class="card card-pad-lg" style="margin-bottom: var(--space-6);">
    <h2 style="margin-top: 0;">Guides & Resources</h2>
    <ul class="quick-links">
      <li><a href="/build-team/"><strong>Team Builder</strong> — Interactive formation builder</a></li>
      <li><a href="/tools/"><strong>Tools & Calculators</strong> — Boss waves, spells, evolution</a></li>
      <li><a href="/professions/"><strong>Profession Guides</strong> — All units by class</a></li>
      <li><a href="/guides/"><strong>Strategy Guides</strong> — Best heroes by cost and mode</a></li>
      <li><a href="/compare/"><strong>Hero Comparisons</strong> — Side-by-side stat matchups</a></li>
      <li><a href="/resources/"><strong>Community Resources</strong> — Discord, YouTube, APK</a></li>
      <li><a href="/data/"><strong>Game Data API</strong> — JSON datasets</a></li>
    </ul>
  </div>
</BaseLayout>
