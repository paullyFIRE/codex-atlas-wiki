---
import BaseLayout from '../layouts/BaseLayout.astro';

const siteTitle = 'War Inc: Rising Wiki | war-inc-rising.codex-atlas.com';
const siteDescription = 'Comprehensive War Inc: Rising wiki — hero stats, skills, equipment, and strategy guides for all game modes.';

const heroIndexFiles = import.meta.glob('/data/pages/heroes/_index.json', { eager: true, import: 'default' });
const buildIndexFiles = import.meta.glob('/data/pages/bosses/_index.json', { eager: true, import: 'default' });
const specIndexFiles = import.meta.glob('/data/pages/special/_index.json', { eager: true, import: 'default' });
const buffIndexFiles = import.meta.glob('/data/pages/buffs/_index.json', { eager: true, import: 'default' });
const synIndexFiles = import.meta.glob('/data/pages/synergies/_index.json', { eager: true, import: 'default' });
const modeIndexFiles = import.meta.glob('/data/pages/modes/_index.json', { eager: true, import: 'default' });
const followerIndexFiles = import.meta.glob('/data/pages/followers/_index.json', { eager: true, import: 'default' });

const heroCount = heroIndexFiles['/data/pages/heroes/_index.json']?.count ?? 0;
const buildingCount = buildIndexFiles['/data/pages/bosses/_index.json']?.count ?? 0;
const specialCount = specIndexFiles['/data/pages/special/_index.json']?.count ?? 0;
const buffCount = buffIndexFiles['/data/pages/buffs/_index.json']?.count ?? 0;
const synCount = synIndexFiles['/data/pages/synergies/_index.json']?.count ?? 0;
const modeCount = modeIndexFiles['/data/pages/modes/_index.json']?.count ?? 0;
const followerCount = followerIndexFiles['/data/pages/followers/_index.json']?.count ?? 0;
---

<BaseLayout title={siteTitle} description={siteDescription}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "VideoGame",
    "name": "War Inc: Rising",
    "applicationCategory": "Game",
    "operatingSystem": "Android",
    "author": { "@type": "Organization", "name": "Fastone Games" },
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "war-inc-rising.codex-atlas.com",
    "url": "https://war-inc-rising.codex-atlas.com",
    "description": "War Inc: Rising wiki with hero stats, skills, equipment data, and strategy guides.",
  })} />

  <h1>War Inc: Rising Wiki</h1>
  <p>
    {siteDescription}
  </p>

  <section>
    <h2>Browse by Category</h2>
    <ul>
      <li><a href="/heroes/">All Heroes</a> — {heroCount} playable units</li>
      <li><a href="/bosses/">Bosses (Hunting Mode)</a> — {buildingCount} boss enemies</li>
      <li><a href="/special/">Special Entities</a> — {specialCount} resource buildings, mines, barracks</li>
      <li><a href="/followers/">Followers</a> — {followerCount} troop and pet units</li>
      <li><a href="/modes/">Game Modes</a> — {modeCount} mode configurations</li>
      <li><a href="/synergies/">Synergies</a> — {synCount} team bonus effects</li>
      <li><a href="/buffs/">Field Buffs</a> — {buffCount} battle modifiers</li>
    </ul>
  </section>

  <section>
    <h2>Guides & Resources</h2>
    <ul>
      <li><a href="/build-team/">Team Builder</a> — Interactive formation builder with synergy detection</li>
      <li><a href="/tools/">Tools & Calculators</a> — Boss waves, spells, evolution, mode loot</li>
      <li><a href="/professions/">Profession Guides</a> — All units by class (Warrior, Tank, Mage, etc.)</li>
      <li><a href="/guides/">Strategy Guides</a> — Best heroes by cost bracket and game mode</li>
      <li><a href="/compare/">Hero Comparisons</a> — Side-by-side stat matchups</li>
      <li><a href="/resources/">Community Resources</a> — Discord, YouTube, APK download</li>
      <li><a href="/data/">Game Data API</a> — Machine-readable JSON datasets</li>
    </ul>
  </section>
</BaseLayout>
