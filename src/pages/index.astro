---
import BaseLayout from '../layouts/BaseLayout.astro';

const siteTitle = 'War Inc: Rising Wiki | war-inc-rising.codex-atlas.com';
const siteDescription = 'Comprehensive War Inc: Rising wiki — hero stats, skills, and strategy guides for all game modes.';

const heroIdx = import.meta.glob('/data/pages/heroes/_index.json', { eager: true, import: 'default' });
const buildIdx = import.meta.glob('/data/pages/buildings/_index.json', { eager: true, import: 'default' });
const buffIdx = import.meta.glob('/data/pages/buffs/_index.json', { eager: true, import: 'default' });
const synIdx = import.meta.glob('/data/pages/synergies/_index.json', { eager: true, import: 'default' });
const modeIdx = import.meta.glob('/data/pages/modes/_index.json', { eager: true, import: 'default' });
const followIdx = import.meta.glob('/data/pages/followers/_index.json', { eager: true, import: 'default' });
const guideIdx = import.meta.glob('/data/pages/guides/_index.json', { eager: true, import: 'default' });
const heroCount = heroIdx['/data/pages/heroes/_index.json']?.count ?? 0;
const buildingCount = buildIdx['/data/pages/buildings/_index.json']?.count ?? 0;
const buffCount = buffIdx['/data/pages/buffs/_index.json']?.count ?? 0;
const synCount = synIdx['/data/pages/synergies/_index.json']?.count ?? 0;
const modeCount = modeIdx['/data/pages/modes/_index.json']?.count ?? 0;
const followerCount = followIdx['/data/pages/followers/_index.json']?.count ?? 0;
const guideCount = guideIdx['/data/pages/guides/_index.json']?.count ?? 0;
---

<BaseLayout title={siteTitle} description={siteDescription}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "VideoGame",
    "name": "War Inc: Rising",
    "applicationCategory": "Game",
    "operatingSystem": "Android",
    "author": { "@type": "Organization", "name": "Fastone Games" },
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "war-inc-rising.codex-atlas.com",
    "url": "https://war-inc-rising.codex-atlas.com",
    "description": "War Inc: Rising wiki with hero stats, skills, and strategy guides.",
  })} />

  <style>
    .home-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); margin-bottom: var(--space-8); }
    .home-card { height: 100%; display: flex; flex-direction: column; }
    .home-card ul { flex: 1; display: flex; flex-direction: column; gap: var(--space-1); }
    .home-card li { margin: 0; }
    .home-card li a { display: block; padding: var(--space-2) var(--space-3); background: var(--surface-muted); border: 1px solid var(--border-light); border-radius: var(--radius-md); font-size: var(--text-sm); transition: all 150ms ease; line-height: 1.4; }
    .home-card li a:hover { background: var(--gold-50); border-color: var(--gold-400); text-decoration: none; transform: translateY(-1px); }
    .home-card li a strong { display: block; font-family: var(--font-heading); color: var(--gold-700); }
    .home-card li a small { display: block; color: #6c757d; font-weight: var(--weight-normal); margin-top: 2px; }
    @media (max-width: 767px) { .home-grid { grid-template-columns: 1fr; } }
  </style>

  <h1>War Inc: Rising Wiki</h1>
  <p>{siteDescription}</p>

  <div class="home-grid">
    <div class="card card-pad-lg home-card">
      <h2 style="margin-top: 0;">Browse by Category</h2>
      <ul class="quick-links">
        <li><a href="/heroes/"><strong>All Heroes</strong><small>{heroCount} playable units with stats, skills, and strategy guides</small></a></li>
        <li><a href="/buildings/"><strong>Buildings</strong><small>{buildingCount} base structures, defenses, and resource buildings</small></a></li>
        <li><a href="/hunting-bosses/"><strong>Hunting Mode Bosses</strong><small>20 boss enemies with stats and abilities</small></a></li>
        <li><a href="/followers/"><strong>Followers</strong><small>{followerCount} troop and pet companion units</small></a></li>
        <li><a href="/modes/"><strong>Game Modes</strong><small>{modeCount} mode configurations with rules and rewards</small></a></li>
        <li><a href="/synergies/"><strong>Synergies</strong><small>{synCount} team bonus effects</small></a></li>
        <li><a href="/buffs/"><strong>Field Buffs</strong><small>{buffCount} battle modifiers</small></a></li>
      </ul>
    </div>

    <div class="card card-pad-lg home-card">
      <h2 style="margin-top: 0;">Guides & Resources</h2>
      <ul class="quick-links">
        <li><a href="/guides/"><strong>Strategy Guides</strong><small>{guideCount} data-driven guides by cost bracket and game mode</small></a></li>
        <li><a href="/professions/"><strong>Profession Guides</strong><small>Class rankings — Warrior, Tank, Mage, Assassin, Support, Ranger</small></a></li>
        <li><a href="/compare/archer-vs-forest-scout/"><strong>Unit Comparisons</strong><small>Side-by-side stat comparison tool — pick any two units</small></a></li>
        <li><a href="/tools/spell-calc/"><strong>Spell Calculator</strong><small>Spell training times, cooldowns, and capacity</small></a></li>
        <li><a href="/tools/evolution/"><strong>Upgrade & Merge Costs</strong><small>Merge requirements and upgrade costs for all rarities</small></a></li>
        <li><a href="/resources/"><strong>Community Resources</strong><small>Discord, YouTube, and official game links</small></a></li>
      </ul>
    </div>
  </div>
</BaseLayout>
