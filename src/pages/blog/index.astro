---
import { readFileSync } from 'fs';
import BaseLayout from '../../layouts/BaseLayout.astro';

const index = JSON.parse(readFileSync('data/pages/blog/_index.json', 'utf-8'));
const items = index.items ?? [];

function loadPost(slug) {
  try {
    return JSON.parse(readFileSync(`data/pages/blog/${slug}.json`, 'utf-8'));
  } catch { return null; }
}

const posts = items.map(item => {
  const data = loadPost(item.slug);
  const preview = data?.preview || '';
  const date = data?.date || '';
  return { slug: item.slug, name: item.name, preview, date, sections: data?.sections || [] };
}).sort((a, b) => b.date.localeCompare(a.date));
---

<BaseLayout
  title="War Inc: Rising Strategy Guides and Tips"
  description="Data-driven War Inc: Rising strategy guides. Learn the best heroes, team compositions, game mode tactics, and progression tips. Updated for 2026."
  currentSection="blog"
>
  <nav class="flex items-center gap-2 text-label-md font-bold text-on-surface-variant mb-8 uppercase tracking-wider">
    <a href="/" class="hover:text-primary no-underline">Home</a>
    <span class="material-symbols-outlined text-xs">chevron_right</span>
    <span class="text-primary bg-primary-container/20 px-3 py-1 rounded-full">Guides & Blog</span>
  </nav>
  <h1 class="font-display text-headline-lg text-on-surface mb-4 leading-none">War Inc: Rising Strategy Guides</h1>
  <p class="text-body-md text-on-surface-variant mb-8">Data-driven guides, tier lists, and strategy articles. Also check <a href="/guides/" class="text-secondary hover:underline">hero recommendations</a> and <a href="/tier-lists/" class="text-secondary hover:underline">tier lists</a>.</p>

  <div class="space-y-6">
    {posts.map((p) => (
      <a href={`/blog/${p.slug}/`} class="bg-white border-4 border-surface-container rounded-xl p-8 clash-card hover:border-primary transition-all group no-underline hover:-translate-y-1 block">
        <time class="text-label-md text-on-surface-variant text-sm mb-3 block">{p.date}</time>
        <h2 class="text-title-md font-display text-on-surface group-hover:text-primary transition-colors mb-3">{p.name}</h2>
        <p class="text-body-md text-on-surface-variant leading-relaxed">{p.preview}</p>
        <span class="flex items-center gap-2 text-label-md font-bold text-primary mt-4">
          {p.sections.length} sections <span class="material-symbols-outlined text-sm opacity-0 group-hover:opacity-100 transition-all group-hover:translate-x-1 ml-auto">arrow_forward</span>
        </span>
      </a>
    ))}
  </div>

  <p class="text-body-md text-on-surface-variant mt-10">
    <a href="/guides/" class="text-secondary hover:underline">Hero recommendations by cost and mode</a> · <a href="/tier-lists/" class="text-secondary hover:underline">Tier lists</a> · <a href="/tools/" class="text-secondary hover:underline">Tools</a>
  </p>
</BaseLayout>
