---
import BaseLayout from '../layouts/BaseLayout.astro';

const datasetSchema = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": "War Inc: Rising Unit Stats Database",
  "description": "Complete extracted unit stats, skills, equipment, and game data for War Inc: Rising (com.i89trillion.strategy.rising). Data extracted from the game APK via UnityPy.",
  "url": "https://war-inc-rising.codex-atlas.com/data/",
  "isAccessibleForFree": true,
  "keywords": ["War Inc: Rising", "game stats", "unit database", "hero stats", "skills", "equipment"],
  "variableMeasured": [
    {"@type": "PropertyValue", "name": "HP", "description": "Hit points per level"},
    {"@type": "PropertyValue", "name": "ATK", "description": "Attack damage per level"},
    {"@type": "PropertyValue", "name": "DEF", "description": "Defense per level"},
    {"@type": "PropertyValue", "name": "Attack Speed", "description": "Attack speed per level"},
    {"@type": "PropertyValue", "name": "Move Speed", "description": "Movement speed per level"},
    {"@type": "PropertyValue", "name": "Combat Power", "description": "Combat power rating per level"},
    {"@type": "PropertyValue", "name": "Rarity", "description": "Unit rarity tier (1-5)"},
    {"@type": "PropertyValue", "name": "Profession", "description": "Unit class/role"},
    {"@type": "PropertyValue", "name": "Cost", "description": "Deployment cost"},
    {"@type": "PropertyValue", "name": "Skill Damage", "description": "Skill effect values per level"}
  ],
  "creator": {"@type": "Organization", "name": "codex-atlas.com"},
  "distribution": [
    {
      "@type": "DataDownload",
      "encodingFormat": "application/json",
      "contentUrl": "https://war-inc-rising.codex-atlas.com/data/unit_database.json"
    },
    {
      "@type": "DataDownload",
      "encodingFormat": "application/json",
      "contentUrl": "https://war-inc-rising.codex-atlas.com/data/skill_data.json"
    }
  ]
};
---

<BaseLayout
  title="War Inc: Rising Game Data — Extracted Stats Database | codex-atlas.com"
  description="Complete extracted database of all War Inc: Rising unit stats, skills, equipment, and game configurations. Machine-readable JSON data from APK extraction."
>
  <script type="application/ld+json" set:html={JSON.stringify(datasetSchema)} />

  <h1>War Inc: Rising Game Data</h1>
  <p>Complete extracted database of unit stats, skills, equipment, and game configurations. All data is extracted directly from the game APK and provided as structured JSON.</p>

  <h2>Available Datasets</h2>
  <table>
    <thead>
      <tr><th>Dataset</th><th>Records</th><th>Format</th><th>Download</th></tr>
    </thead>
    <tbody>
      <tr><td>Unit Database</td><td>251 units</td><td>JSON</td><td><a href="/data/unit_database.json">Download</a></td></tr>
      <tr><td>Unit Stats</td><td>251 × 12 levels</td><td>JSON</td><td><a href="/data/unit_stats.json">Download</a></td></tr>
      <tr><td>Skill Data</td><td>441 skills × 12 levels</td><td>JSON</td><td><a href="/data/skill_data.json">Download</a></td></tr>
      <tr><td>Unit Names</td><td>389 names</td><td>JSON</td><td><a href="/data/unit_name_map.json">Download</a></td></tr>
      <tr><td>Equipment</td><td>160 items</td><td>JSON</td><td><a href="/data/config/equip_battle.json">Download</a></td></tr>
      <tr><td>Game Modes</td><td>5 modes</td><td>JSON</td><td><a href="/data/config/battle_conf_lib.json">Download</a></td></tr>
      <tr><td>Synergies</td><td>9 synergies</td><td>JSON</td><td><a href="/data/config/battle_synergy.json">Download</a></td></tr>
      <tr><td>Field Buffs</td><td>36 buffs</td><td>JSON</td><td><a href="/data/config/field_buff.json">Download</a></td></tr>
    </tbody>
  </table>

  <h2>Data Source</h2>
  <p>Data extracted from game version <code>com.i89trillion.strategy.rising</code> APK using UnityPy. The extraction pipeline is fully scripted in <code>scripts/extract_all.py</code> and <code>scripts/generate_pages.py</code>.</p>
</BaseLayout>
