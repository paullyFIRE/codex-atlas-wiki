---
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const pages = import.meta.glob('/data/pages/followers/*.json', { eager: true, import: 'default' });
  const index = pages['/data/pages/followers/_index.json'];
  const items = index?.items ?? [];
  return items.map((item) => ({
    params: { slug: item.slug },
    props: { slug: item.slug },
  }));
}

const { slug } = Astro.params;

const files = import.meta.glob('/data/pages/followers/*.json', { eager: true, import: 'default' });
const pageData = files[`/data/pages/followers/${slug}.json`];
if (!pageData) return Astro.redirect('/followers/', 404);
---

<BaseLayout title={pageData.title} description={pageData.meta_description}>
  <script type="application/ld+json" set:html={JSON.stringify(pageData.schema)} />
  <script type="application/ld+json" set:html={JSON.stringify(pageData.breadcrumb_schema)} />

  <nav aria-label="Breadcrumb">
    <a href="/">Home</a> &gt; <a href="/followers/">Followers</a> &gt; <span>{pageData.name}</span>
  </nav>

  <article>
    <header>
      {pageData.image && <img src={pageData.image} alt={pageData.name} width="120" height="120" style="float:right;border-radius:8px;" />}
      <h1>{pageData.name}</h1>
      <p>{pageData.rarity_name} · Cost {pageData.cost} · Power {pageData.combat_power}</p>
    </header>

    <section>
      <h2>Stats by Level</h2>
      <table>
        <thead>
          <tr>
            <th>Level</th>
            <th>HP</th>
            <th>ATK</th>
            <th>DEF</th>
            <th>ATK Speed</th>
            <th>Move Speed</th>
            <th>Range</th>
            <th>Power</th>
          </tr>
        </thead>
        <tbody>
          {pageData.stats_table?.map((row) => (
            <tr>
              <td>{row.level}</td>
              <td>{row.hp ?? '-'}</td>
              <td>{row.atk ?? '-'}</td>
              <td>{row.def ?? '-'}</td>
              <td>{row.attack_speed ?? '-'}</td>
              <td>{row.move_speed ?? '-'}</td>
              <td>{row.attack_range ?? '-'}</td>
              <td>{row.combat_power ?? '-'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    {pageData.skills?.length > 0 && (
      <section>
        <h2>Abilities</h2>
        {pageData.skills.map((skill) => (
          <div class="skill">
            <h3>{skill.name}</h3>
            {skill.description && <p>{skill.description}</p>}
          </div>
        ))}
      </section>
    )}

    <section>
      <h2>How to Use {pageData.name}</h2>
      <ul>
        {pageData.strategy_tips?.map((tip) => <li>{tip}</li>)}
      </ul>
    </section>
  </article>
</BaseLayout>
