---
import { readFileSync } from 'fs';
import BaseLayout from '../../layouts/BaseLayout.astro';

const cg = JSON.parse(readFileSync('data/processed/config/card_growth.json', 'utf-8'));
const nm = JSON.parse(readFileSync('data/processed/unit_name_map.json', 'utf-8'));
const sf = cg.spellFactory || {};
const spells = (sf.spellItems || []).map(s => ({
  id: s.id,
  name: nm[String(s.id)] || s.name,
  trainSec: s.trainSec,
  capacity: s.capacity,
  cooldown: s.cd,
  target: s.target,
  range: s.range,
}));
---

<BaseLayout title="Spell Calculator — Training & Cooldown | War Inc: Rising Wiki"
  description="Calculate spell training times, cooldowns, and capacity for the Spell Cauldron.">
  <nav class="flex items-center gap-2 text-label-md font-bold text-on-surface-variant mb-8 uppercase tracking-wider">
    <a href="/" class="hover:text-primary no-underline">Home</a>
    <span class="material-symbols-outlined text-xs">chevron_right</span>
    <a href="/tools/" class="hover:text-primary no-underline">Tools</a>
    <span class="material-symbols-outlined text-xs">chevron_right</span>
    <span class="text-primary bg-primary-container/20 px-3 py-1 rounded-full">Spell Calculator</span>
  </nav>
  <h1 class="font-display text-headline-lg text-on-surface mb-4 leading-none">Spell Calculator</h1>
  <p class="text-body-md text-on-surface-variant mb-8">Spell training times, cooldowns, and capacity from the Spell Cauldron.</p>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {spells.map(s => (
      <div class="bg-white border-4 border-surface-container rounded-xl p-6 clash-card">
        <h3 class="text-title-md font-display text-on-surface mb-6 pb-4 border-b-4 border-surface-container-low">{s.name}</h3>
        <div class="space-y-4">
          <div class="flex justify-between items-center">
            <span class="text-label-md text-on-surface-variant uppercase tracking-wider text-sm">Training</span>
            <span class="text-title-md font-display text-on-surface">{Math.floor(s.trainSec / 60)}m {s.trainSec % 60}s</span>
          </div>
          <div class="flex justify-between items-center border-t-2 border-surface-container pt-3">
            <span class="text-label-md text-on-surface-variant uppercase tracking-wider text-sm">Capacity</span>
            <span class="text-title-md font-display text-on-surface">{s.capacity}</span>
          </div>
          <div class="flex justify-between items-center border-t-2 border-surface-container pt-3">
            <span class="text-label-md text-on-surface-variant uppercase tracking-wider text-sm">Cooldown</span>
            <span class="text-title-md font-display text-on-surface">{s.cooldown}s</span>
          </div>
          <div class="flex justify-between items-center border-t-2 border-surface-container pt-3">
            <span class="text-label-md text-on-surface-variant uppercase tracking-wider text-sm">Range</span>
            <span class="text-title-md font-display text-on-surface">{s.range}</span>
          </div>
          <div class="flex justify-between items-center border-t-2 border-surface-container pt-3">
            <span class="text-label-md text-on-surface-variant uppercase tracking-wider text-sm">Target</span>
            <span class="text-title-md font-display text-on-surface">{s.target === 1 ? 'Enemies' : 'Allies'}</span>
          </div>
        </div>
      </div>
    ))}
  </div>
</BaseLayout>
