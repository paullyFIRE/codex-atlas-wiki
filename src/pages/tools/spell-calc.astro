---
import { readFileSync } from 'fs';
import BaseLayout from '../../layouts/BaseLayout.astro';

const cg = JSON.parse(readFileSync('data/processed/config/card_growth.json', 'utf-8'));
const nm = JSON.parse(readFileSync('data/processed/unit_name_map.json', 'utf-8'));
const sf = cg.spellFactory || {};
const spells = (sf.spellItems || []).map(s => ({
  id: s.id,
  name: nm[String(s.id)] || s.name,
  trainSec: s.trainSec,
  capacity: s.capacity,
  cooldown: s.cd,
  target: s.target,
  range: s.range,
}));
---

<BaseLayout title="Spell Calculator — Training & Cooldown | War Inc: Rising Wiki"
  description="Calculate spell training times, cooldowns, and capacity for the Spell Cauldron.">
  <style>
    .spell-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: var(--space-4); }
    .spell-card { border: 1px solid var(--border-light); border-radius: var(--radius-lg); padding: var(--space-4); background: var(--surface-card); box-shadow: var(--shadow-xs), var(--bevel-outset); }
    .spell-row { display: flex; justify-content: space-between; padding: var(--space-2) 0; border-bottom: 1px solid var(--border-light); }
    .spell-row:last-child { border-bottom: none; }
    .spell-row .l { font-size: var(--text-xs); color: #6c757d; text-transform: uppercase; letter-spacing: 0.03em; }
    .spell-row .v { font-family: var(--font-stat); font-size: var(--text-lg); font-weight: var(--weight-bold); font-variant-numeric: tabular-nums; }
  </style>

  <nav class="breadcrumb">
    <a href="/">Home</a>
    <span class="breadcrumb-sep">›</span>
    <a href="/tools/">Tools</a>
    <span class="breadcrumb-sep">›</span>
    <span>Spell Calculator</span>
  </nav>

  <h1>Spell Calculator</h1>
  <p>Spell training times, cooldowns, and capacity from the <a href="/buildings/spell-cauldron/">Spell Cauldron</a>.</p>

  <div class="spell-grid">
  {spells.map(s => (
    <div class="spell-card">
      <h3 style="margin-top: 0;">{s.name}</h3>
      <div class="spell-row"><span class="l">Training</span><span class="v">{Math.floor(s.trainSec / 60)}m {s.trainSec % 60}s</span></div>
      <div class="spell-row"><span class="l">Capacity</span><span class="v">{s.capacity}</span></div>
      <div class="spell-row"><span class="l">Cooldown</span><span class="v">{s.cooldown}s</span></div>
      <div class="spell-row"><span class="l">Range</span><span class="v">{s.range}</span></div>
      <div class="spell-row"><span class="l">Target</span><span class="v">{s.target === 1 ? 'Enemies' : 'Allies'}</span></div>
    </div>
  ))}
  </div>
</BaseLayout>
