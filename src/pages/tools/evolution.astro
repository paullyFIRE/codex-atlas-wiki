---
import { readFileSync } from 'fs';
import BaseLayout from '../../layouts/BaseLayout.astro';

const cg = JSON.parse(readFileSync('data/processed/config/card_growth.json', 'utf-8'));

// Merge costs by rarity + level
const merge = (cg.merge || []).filter(m => m.cost && m.cost.length > 0);

// Item name lookup for known IDs
const ITEM_NAMES = {
  124: 'Sliver Coin',
  440: 'Forge Stone',
};

const rarityNames = { 1: "Common", 2: "Rare", 3: "Epic", 4: "Legendary", 5: "Mythic" };
const mergeByRarity = {};
for (const m of merge) {
  if (!mergeByRarity[m.rarity]) mergeByRarity[m.rarity] = [];
  mergeByRarity[m.rarity].push(m);
}
---

<BaseLayout title="Upgrade & Merge Costs — War Inc: Rising"
  description="Merge requirements and upgrade costs for all rarities.">
  <nav class="breadcrumb">
    <a href="/">Home</a>
    <span class="breadcrumb-sep">›</span>
    <a href="/tools/">Tools</a>
    <span class="breadcrumb-sep">›</span>
    <span>Upgrade & Merge Costs</span>
  </nav>

  <h1>Upgrade & Merge Costs</h1>
  <p>Cost to merge units of each rarity at each level. Items: <strong>Forge Stone</strong> (item 440) and <strong>Sliver Coin</strong> (item 124).</p>

  <div style="display: flex; gap: var(--space-2); margin-bottom: var(--space-6);">
    <span class="stat-chip"><span class="stat-chip-label">Forge Stone</span><span class="stat-chip-value">440</span></span>
    <span class="stat-chip"><span class="stat-chip-label">Sliver Coin</span><span class="stat-chip-value">124</span></span>
  </div>

  {Object.entries(mergeByRarity).map(([rarity, items]) => (
    <div style="margin-bottom: var(--space-6);">
      <h2>{rarityNames[rarity] || `Rarity ${rarity}`}</h2>
      <div class="table-wrap">
        <table class="wiki-table">
          <thead><tr><th>Level</th><th>Cost</th></tr></thead>
          <tbody>
          {items.map(m => (
            <tr><td><strong>+{m.lv}</strong></td><td>{m.cost.map(c => `${ITEM_NAMES[c.itemId] || `Item ${c.itemId}`} ×${c.itemCnt}`).join(', ')}</td></tr>
          ))}
          </tbody>
        </table>
      </div>
    </div>
  ))}
</BaseLayout>
