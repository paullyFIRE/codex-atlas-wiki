---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Tools & Calculators — War Inc: Rising Wiki"
  description="Interactive tools and calculators for War Inc: Rising — spell calculator, upgrade costs."
  currentSection="tools"
>
  <nav class="breadcrumb">
    <a href="/">Home</a>
    <span class="breadcrumb-sep">›</span>
    <span>Tools</span>
  </nav>

  <h1>Tools</h1>

  <div class="card card-pad-md card-hoverable" style="margin-bottom: var(--space-4);">
    <h2 style="margin: 0 0 var(--space-2);"><a href="/tools/spell-calc/" style="text-decoration: none;">Spell Calculator</a></h2>
    <p style="margin: 0;">Spell training times, cooldowns, capacity, and speed-up costs from the Spell Cauldron.</p>
  </div>
  <div class="card card-pad-md card-hoverable" style="margin-bottom: var(--space-4);">
    <h2 style="margin: 0 0 var(--space-2);"><a href="/tools/evolution/" style="text-decoration: none;">Upgrade & Merge Costs</a></h2>
    <p style="margin: 0;">Merge requirements and upgrade costs for all rarities.</p>
  </div>
</BaseLayout>
