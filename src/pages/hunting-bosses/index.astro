---
import BaseLayout from '../../layouts/BaseLayout.astro';

const files = import.meta.glob('/data/pages/hunting-bosses/_index.json', { eager: true, import: 'default' });
const index = files['/data/pages/hunting-bosses/_index.json'] ?? { items: [], count: 0 };
const items = index.items ?? [];
---

<BaseLayout
  title="All Hunting Mode Bosses | War Inc: Rising Wiki"
  description={`Browse all ${items.length} Hunting mode bosses in War Inc: Rising. Stats, abilities, and strategies.`}
>
  <nav class="breadcrumb">
    <a href="/">Home</a>
    <span class="breadcrumb-sep">›</span>
    <span>Hunting Mode Bosses</span>
  </nav>
  <h1>All Hunting Mode Bosses</h1>
  <p>{items.length} boss enemies encountered in Hunting mode.</p>
  <ul class="listing-grid">
    {items.sort((a, b) => b.combat_power - a.combat_power).map((item) => (
      <li><a href={`/hunting-bosses/${item.slug}/`} class="card card-pad-md card-hoverable" style="display:block;text-decoration:none;color:inherit;"><strong>{item.name}</strong></a></li>
    ))}
  </ul>
</BaseLayout>
