---
import BaseLayout from '../../layouts/BaseLayout.astro';

const STAT_NAMES = {
  1053: "HP%", 1073: "ATK%", 1083: "DEF%",
  1050: "HP", 1070: "ATK", 1080: "DEF",
  1100: "Move Spd", 1090: "ATK Spd",
};
function statName(id) { return STAT_NAMES[id] ?? `Stat ${id}`; }

export async function getStaticPaths() {
  const pages = import.meta.glob('/data/pages/equipment/*.json', { eager: true, import: 'default' });
  const index = pages['/data/pages/equipment/_index.json'];
  const items = index?.items ?? [];
  return items.map((item) => ({
    params: { slug: item.slug },
    props: { slug: item.slug },
  }));
}

const { slug } = Astro.params;

const files = import.meta.glob('/data/pages/equipment/*.json', { eager: true, import: 'default' });
const pageData = files[`/data/pages/equipment/${slug}.json`];
if (!pageData) return Astro.redirect('/equipment/', 404);
---

<BaseLayout title={pageData.title} description={pageData.meta_description}>
  <script type="application/ld+json" set:html={JSON.stringify(pageData.schema)} />

  <nav aria-label="Breadcrumb">
    <a href="/">Home</a> &gt; <a href="/equipment/">Equipment</a> &gt; <span>{pageData.name}</span>
  </nav>

  <article>
    <header>
      <h1>{pageData.name}</h1>
      <p>Target: {pageData.camp_name} · {pageData.stats_by_tier.length} upgrade tiers</p>
    </header>

    <section>
      <h2>Stats by Tier</h2>
      <table>
        <thead>
          <tr>
            <th>Tier</th>
            {pageData.stats_by_tier[0]?.buffs.map((b) => <th>{statName(b.stat)}</th>)}
          </tr>
        </thead>
        <tbody>
          {pageData.stats_by_tier.map((tier) => (
            <tr>
              <td>{tier.tier}</td>
              {tier.buffs.map((b) => <td>{b.value}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  </article>
</BaseLayout>
