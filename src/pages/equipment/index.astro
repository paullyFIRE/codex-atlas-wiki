---
import BaseLayout from '../../layouts/BaseLayout.astro';

const files = import.meta.glob('/data/pages/equipment/_index.json', { eager: true, import: 'default' });
const index = files['/data/pages/equipment/_index.json'] ?? { items: [], count: 0 };
const items = index.items ?? [];
---

<BaseLayout
  title="All Equipment - Stats and Tiers | War Inc: Rising Wiki"
  description={`Browse all ${items.length} equipment items in War Inc: Rising across 5 upgrade tiers.`}
>
  <h1>All Equipment</h1>
  <p>{items.length} items.</p>

  <ul>
    {items.map((item) => (
      <li><a href={`/equipment/${item.slug}/`}>{item.name}</a></li>
    ))}
  </ul>
</BaseLayout>
