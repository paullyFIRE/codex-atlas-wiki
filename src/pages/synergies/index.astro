---
import BaseLayout from '../../layouts/BaseLayout.astro';

const files = import.meta.glob('/data/pages/synergies/_index.json', { eager: true, import: 'default' });
const index = files['/data/pages/synergies/_index.json'] ?? { items: [], count: 0 };
const items = index.items ?? [];
---

<BaseLayout
  title="Synergies - Team Bonus Effects | War Inc: Rising"
  description={`Browse all ${items.length} synergy effects in War Inc: Rising.`}
>
  <nav class="breadcrumb">
    <a href="/">Home</a>
    <span class="breadcrumb-sep">›</span>
    <span>Synergies</span>
  </nav>
  <h1>Synergies</h1>
  <p>{items.length} team bonus effects that activate when specific units are deployed together.</p>
  <ul class="listing-grid">
    {items.map((item) => (
      <li><a href={`/synergies/${item.slug}/`} class="card card-pad-md card-hoverable" style="display:block;text-decoration:none;color:inherit;"><strong>{item.name}</strong></a></li>
    ))}
  </ul>
</BaseLayout>
