---
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const pages = import.meta.glob('/data/pages/synergies/*.json', { eager: true, import: 'default' });
  const index = pages['/data/pages/synergies/_index.json'];
  const items = index?.items ?? [];
  return items.map((item) => ({
    params: { slug: item.slug },
    props: { slug: item.slug },
  }));
}

const { slug } = Astro.params;

const files = import.meta.glob('/data/pages/synergies/*.json', { eager: true, import: 'default' });
const pageData = files[`/data/pages/synergies/${slug}.json`];
if (!pageData) return Astro.redirect('/synergies/', 404);
---

<BaseLayout title={pageData.title} description={pageData.meta_description}>
  <script type="application/ld+json" set:html={JSON.stringify(pageData.schema)} />

  <nav class="flex items-center gap-2 text-label-md font-bold text-on-surface-variant mb-8 uppercase tracking-wider">
    <a href="/" class="hover:text-primary no-underline">Home</a>
    <span class="material-symbols-outlined text-xs">chevron_right</span>
    <a href="/synergies/" class="hover:text-primary no-underline">Synergies</a>
    <span class="material-symbols-outlined text-xs">chevron_right</span>
    <span class="text-primary bg-primary-container/20 px-3 py-1 rounded-full">{pageData.name}</span>
  </nav>

  <article>
    <header>
      <h1>{pageData.name}</h1>
    </header>

    <section>
      <h2>Effect Description</h2>
      <p>{pageData.remark}</p>

      {pageData.effects.length > 0 && (
        <>
          <h2>Affected Units</h2>
          <ul>
            {pageData.effects.map((eff) => (
              <li>Condition type {eff.cond_type} — Units: {eff.options.join(', ')}</li>
            ))}
          </ul>
        </>
      )}
    </section>
  </article>
</BaseLayout>
