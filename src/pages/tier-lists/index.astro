---
import { readFileSync } from 'fs';
import BaseLayout from '../../layouts/BaseLayout.astro';

const index = JSON.parse(readFileSync('data/pages/tier-lists/_index.json', 'utf-8'));
const items = index.items ?? [];

function loadTier(slug) {
  try {
    return JSON.parse(readFileSync(`data/pages/tier-lists/${slug}.json`, 'utf-8'));
  } catch { return null; }
}

const tierLists = items.map(item => {
  const data = loadTier(item.slug);
  const tiers = data?.tiers || {};
  const sCount = tiers['S']?.length || 0;
  const total = data?.count || 0;
  let desc = '';
  if (item.slug === 'overall') desc = `All ${total} heroes ranked from S-Tier (${sCount} heroes) to F-Tier.`;
  else if (item.slug.includes('tier-list')) desc = `${total} ${item.name.replace(' Tier List', '')} heroes ranked by combat power.`;
  else desc = `${total} heroes ranked.`;
  return { slug: item.slug, name: item.name, desc, total };
});
---

<BaseLayout
  title="War Inc: Rising Tier Lists — Hero Rankings by Mode and Class"
  description="Complete War Inc: Rising tier lists ranking all heroes from S-Tier to F-Tier. Find the best heroes for every game mode and profession. Updated 2026."
  currentSection="guides"
>
  <nav class="flex items-center gap-2 text-label-md font-bold text-on-surface-variant mb-8 uppercase tracking-wider">
    <a href="/" class="hover:text-primary no-underline">Home</a>
    <span class="material-symbols-outlined text-xs">chevron_right</span>
    <span class="text-primary bg-primary-container/20 px-3 py-1 rounded-full">Tier Lists</span>
  </nav>
  <h1 class="font-display text-headline-lg text-on-surface mb-4 leading-none">War Inc: Rising Tier Lists</h1>
  <p class="text-body-md text-on-surface-variant mb-8">S-Tier to F-Tier rankings for every hero, by game mode and profession. Built from extracted game data.</p>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {tierLists.map((t) => (
      <a href={`/tier-lists/${t.slug}/`} class="bg-white border-4 border-surface-container rounded-xl p-8 clash-card hover:border-primary transition-all group no-underline hover:-translate-y-1 block">
        <h2 class="text-title-md font-display text-on-surface group-hover:text-primary transition-colors">{t.name}</h2>
        <p class="text-body-md text-on-surface-variant mt-3">{t.desc} ({t.total} heroes)</p>
        <span class="flex items-center gap-2 text-label-md font-bold text-primary mt-4">
          View Rankings <span class="material-symbols-outlined text-sm opacity-0 group-hover:opacity-100 transition-all group-hover:translate-x-1">arrow_forward</span>
        </span>
      </a>
    ))}
  </div>
</BaseLayout>
