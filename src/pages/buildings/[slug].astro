---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntityHeader from '../../components/content/EntityHeader.astro';
import StatGrid from '../../components/content/StatGrid.astro';
import SectionNav from '../../components/content/SectionNav.astro';

export async function getStaticPaths() {
  const pages = import.meta.glob('/data/pages/buildings/*.json', { eager: true, import: 'default' });
  const index = pages['/data/pages/buildings/_index.json'];
  const items = index?.items ?? [];
  return items.map((item) => ({
    params: { slug: item.slug },
    props: { slug: item.slug },
  }));
}

const { slug } = Astro.params;

const files = import.meta.glob('/data/pages/buildings/*.json', { eager: true, import: 'default' });
const pageData = files[`/data/pages/buildings/${slug}.json`];
if (!pageData) return Astro.redirect('/buildings/', 404);

const upgrades = pageData.upgrade_table ?? [];
const production = pageData.resource_production ?? null;

const lv1 = pageData.stats_table?.[0] ?? {};
const statItems = [
  { label: 'HP', value: lv1.hp ?? '-' },
  { label: 'ATK', value: lv1.atk ?? '-' },
  { label: 'DEF', value: lv1.def ?? '-' },
  { label: 'Power', value: lv1.combat_power ?? pageData.combat_power ?? '-' },
];

const sectionLinks = [
  ...(upgrades.length > 0 ? [{ href: '#upgrades', label: 'Upgrades' }] : []),
  { href: '#stats', label: 'Stats' },
  { href: '#related', label: 'Related' },
];
---

<BaseLayout title={pageData.title} description={pageData.meta_description} currentSection="buildings">
  <script type="application/ld+json" set:html={JSON.stringify(pageData.schema)} />
  <script type="application/ld+json" set:html={JSON.stringify(pageData.breadcrumb_schema)} />

  <nav class="breadcrumb">
    <a href="/">Home</a>
    <span class="breadcrumb-sep">›</span>
    <a href="/buildings/">Buildings</a>
    <span class="breadcrumb-sep">›</span>
    <span>{pageData.name}</span>
  </nav>

  <article>
    <EntityHeader
      name={pageData.name}
      image={pageData.image}
      badges={pageData.rarity_name ? [{ label: pageData.rarity_name, variant: 'rarity', level: pageData.rarity }] : []}
      cost={pageData.cost}
      power={pageData.combat_power}
    />

    <SectionNav links={sectionLinks} />

    {upgrades.length > 0 && (
      <section id="upgrades">
        <h2>Upgrade Costs & Requirements</h2>
        <div class="table-wrap">
          <table class="wiki-table">
            <thead>
              <tr><th>Level</th><th>Cost</th><th>Time</th><th>Prerequisites</th><th>Unlocks</th></tr>
            </thead>
            <tbody>
              {upgrades.map((row) => (
                <tr>
                  <td><strong>{row.level}</strong></td>
                  <td>{row.costs.map(c => `${c.count} ${c.item}`).join(', ') || 'Free'}</td>
                  <td>{row.time}</td>
                  <td>{row.pre_reqs.join(', ') || 'None'}</td>
                  <td>{row.unlocks.join(', ') || '-'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {production && (
      <section>
        <h2>Resource Production</h2>
        <div class="table-wrap">
          <table class="wiki-table">
            <thead><tr><th>Level</th><th>Production</th><th>Capacity</th></tr></thead>
            <tbody>
              {production.levels.map((l) => (
                <tr><td>{l.level}</td><td>{l.production}/tick</td><td>{l.capacity}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    <section id="stats">
      <h2>{pageData.name}'s stats by level</h2>
      <StatGrid items={statItems} />
      <div class="table-wrap">
        <table class="wiki-table">
          <thead><tr><th>Level</th><th data-align="right">HP</th><th data-align="right">ATK</th><th data-align="right">DEF</th><th data-align="right">Power</th></tr></thead>
          <tbody>
            {pageData.stats_table?.map((row) => (
              <tr>
                <td><strong>{row.level}</strong></td>
                <td data-type="number">{row.hp ?? '-'}</td>
                <td data-type="number">{row.atk ?? '-'}</td>
                <td data-type="number">{row.def ?? '-'}</td>
                <td data-type="number">{row.combat_power ?? '-'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section id="related">
      <h2>Related</h2>
      <ul class="quick-links">
        <li><a href="/buildings/">Browse All Buildings</a></li>
        <li><a href="/tools/evolution/">Upgrade Costs & Evolution</a></li>
        <li><a href="/heroes/">Browse Heroes</a></li>
        <li><a href="/special/">Special Entities</a></li>
        {production?.levels?.[0]?.item_name && <li>Produces: {production.levels[0].item_name}</li>}
      </ul>
    </section>
  </article>
</BaseLayout>
