---
import BaseLayout from '../../layouts/BaseLayout.astro';

const files = import.meta.glob('/data/pages/buildings/_index.json', { eager: true, import: 'default' });
const index = files['/data/pages/buildings/_index.json'] ?? { items: [], count: 0 };
const items = index.items ?? [];
---

<BaseLayout
  title="All Buildings - Stats and Upgrades | War Inc: Rising Wiki"
  description={`Browse all ${items.length} buildings in War Inc: Rising.`}
  currentSection="buildings"
>
  <nav class="breadcrumb">
    <a href="/">Home</a>
    <span class="breadcrumb-sep">›</span>
    <span>Buildings</span>
  </nav>
  <h1>All Buildings</h1>
  <p>{items.length} base structures, defenses, and resource buildings.</p>
  <ul class="listing-grid">
    {items.map((item) => (
      <li><a href={`/buildings/${item.slug}/`} class="card card-pad-md card-hoverable" style="display:block;text-decoration:none;color:inherit;"><strong>{item.name}</strong></a></li>
    ))}
  </ul>
</BaseLayout>
