---
import BaseLayout from '../../layouts/BaseLayout.astro';

const indexFiles = import.meta.glob('/data/pages/buildings/_index.json', { eager: true, import: 'default' });
const index = indexFiles['/data/pages/buildings/_index.json'] ?? { items: [], count: 0 };
const items = index.items ?? [];
---

<BaseLayout
  title="All Buildings - Stats and Upgrades | War Inc: Rising Wiki"
  description={`Browse all ${items.length} defensive structures in War Inc: Rising.`}
>
  <h1>All Buildings</h1>
  <p>{items.length} defensive structures.</p>

  <ul>
    {items.sort((a, b) => b.combat_power - a.combat_power).map((item) => (
      <li>
        <a href={`/buildings/${item.slug}/`}>{item.name}</a>
        <span class="meta">{item.rarity_name} · Cost {item.cost} · Power {item.combat_power}</span>
      </li>
    ))}
  </ul>
</BaseLayout>
