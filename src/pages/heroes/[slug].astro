---
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const pages = import.meta.glob('/data/pages/heroes/*.json', { eager: true, import: 'default' });
  const index = pages['/data/pages/heroes/_index.json'];
  const items = index?.items ?? [];
  return items.map((item) => ({
    params: { slug: item.slug },
    props: { slug: item.slug },
  }));
}

const { slug } = Astro.params;

let pageData;
try {
  const pages = import.meta.glob('/data/pages/heroes/*.json', { eager: true, import: 'default' });
  pageData = pages[`/data/pages/heroes/${slug}.json`];
} catch {}

if (!pageData) {
  return Astro.redirect('/heroes/', 404);
}

const topRelated = pageData.related?.[0];
const costBracket = pageData.cost <= 2 ? 'low' : pageData.cost <= 4 ? 'mid' : 'high';
const costLabel = pageData.cost <= 2 ? 'Low' : pageData.cost <= 4 ? 'Mid' : 'High';
---

<BaseLayout title={pageData.title} description={pageData.meta_description}>
  <script type="application/ld+json" set:html={JSON.stringify(pageData.schema)} />
  <script type="application/ld+json" set:html={JSON.stringify(pageData.breadcrumb_schema)} />

  <nav aria-label="Breadcrumb">
    <a href="/">Home</a> &gt; <a href="/heroes/">Heroes</a> &gt; <span>{pageData.name}</span>
  </nav>

  <article>
    <header>
      {pageData.image && <img src={pageData.image} alt={pageData.name} width="120" height="120" style="float:right;border-radius:8px;max-width:120px;" />}
      <h1>{pageData.name}</h1>
      <p>
        <span class="rarity">{pageData.rarity_name}</span>
        <span class="profession">{pageData.profession_name}</span>
        <span class="cost">Cost: {pageData.cost}</span>
        <span class="power">Power: {pageData.combat_power}</span>
      </p>
    </header>

    <nav style="margin-bottom:1rem;font-size:0.9rem;display:flex;gap:1rem;flex-wrap:wrap;">
      <a href="#stats">Stats</a>
      {pageData.skills.length > 0 && <a href="#skills">Skills</a>}
      <a href="#strategy">Strategy</a>
      {pageData.related.length > 0 && <a href="#related">Related</a>}
      <a href="#resources">More</a>
    </nav>

    <section id="stats">
      <h2>What are {pageData.name}'s stats by level?</h2>
      <table>
        <thead>
          <tr>
            <th>Level</th>
            <th>HP</th>
            <th>ATK</th>
            <th>DEF</th>
            <th>ATK Speed</th>
            <th>Move Speed</th>
            <th>Range</th>
            <th>Power</th>
          </tr>
        </thead>
        <tbody>
          {pageData.stats_table.map((row) => (
            <tr>
              <td>{row.level}</td>
              <td>{row.hp ?? '-'}</td>
              <td>{row.atk ?? '-'}</td>
              <td>{row.def ?? '-'}</td>
              <td>{row.attack_speed ?? '-'}</td>
              <td>{row.move_speed ?? '-'}</td>
              <td>{row.attack_range ?? '-'}</td>
              <td>{row.combat_power ?? '-'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    {pageData.skills.length > 0 && (
      <section id="skills">
        <h2>What skills does {pageData.name} have?</h2>
        {pageData.skills.map((skill) => (
          <div class="skill">
            <h3>{skill.name}</h3>
            {skill.description && <p>{skill.description}</p>}
            {Object.keys(skill.level_effects).length > 0 && (
              <table>
                <thead>
                  <tr>
                    <th>Level</th>
                    {Object.keys(Object.values(skill.level_effects)[0] || {}).map((key) => (
                      <th>{key.replace(/_/g, ' ')}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {Object.entries(skill.level_effects).map(([lv, effects]) => (
                    <tr>
                      <td>{lv}</td>
                      {Object.values(effects).map((val) => (
                        <td>{val}</td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            )}
          </div>
        ))}
      </section>
    )}

    <section id="strategy">
      <h2>How to use {pageData.name} effectively?</h2>
      <ul>
        {pageData.strategy_tips?.map((tip) => <li>{tip}</li>)}
      </ul>
    </section>

    {pageData.related.length > 0 && (
      <section id="related">
        <h2>Related Heroes</h2>
        <ul>
          {pageData.related.map((r) => (
            <li>
              <a href={`/heroes/${r.slug}/`}>{r.name}</a>
              <span class="meta">{r.rarity_name} · {r.profession_name}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section id="resources">
      <h2>Quick Links</h2>
      <ul style="columns:2;column-gap:2rem;">
        <li><a href={`/professions/${pageData.profession_name?.toLowerCase()}/`}>All {pageData.profession_name}s</a></li>
        <li><a href={`/guides/best-${costBracket}-cost-units/`}>Best {costLabel} Cost Units</a></li>
        <li><a href={`/heroes/`}>Browse All Heroes</a></li>
        {topRelated && <li><a href={`/compare/${pageData.slug}-vs-${topRelated.slug}/`}>{pageData.name} vs {topRelated.name}</a></li>}
        <li><a href={`/build-team/`}>Team Builder — add {pageData.name} to a formation</a></li>
        <li><a href={`/guides/best-heroes-for-general-lineup/`}>Best Heroes for General Lineup</a></li>
        <li><a href={`/rarities/${pageData.rarity_name?.toLowerCase()}-units/`}>All {pageData.rarity_name} Units</a></li>
        <li><a href="/tools/">Tools & Calculators</a></li>
      </ul>
    </section>
  </article>
</BaseLayout>
