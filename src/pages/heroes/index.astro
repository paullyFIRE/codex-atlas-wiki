---
import BaseLayout from '../../layouts/BaseLayout.astro';

const indexFiles = import.meta.glob('/data/pages/heroes/_index.json', { eager: true, import: 'default' });
const index = indexFiles['/data/pages/heroes/_index.json'] ?? { items: [], count: 0 };
const items = index.items ?? [];

const PROFESSION_ORDER = ['Tank', 'Warrior', 'Assassin', 'Mage', 'Support', 'Ranger', 'Special'];
const PROFESSION_DESC = {
  Tank: 'High HP and DEF. Absorbs damage, protects allies.',
  Warrior: 'Balanced melee fighters. Reliable damage and survivability.',
  Assassin: 'High single-target burst. Eliminates key threats.',
  Mage: 'Area magic damage. Effective against groups.',
  Support: 'Healing, buffs, and utility. Extends team survivability.',
  Ranger: 'Ranged physical damage. Safe distance attackers.',
  Special: 'Unique roles with situational strengths.',
};

const groups = {};
for (const p of PROFESSION_ORDER) {
  const members = items.filter(i => i.profession_name === p).sort((a, b) => (b.combat_power ?? 0) - (a.combat_power ?? 0));
  if (members.length > 0) groups[p] = members;
}

function getInitials(name) {
  const parts = name.trim().split(/\s+/);
  if (parts.length >= 2) {
    return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
  }
  const n = parts[0];
  if (n.length <= 1) return (n + '?').toUpperCase();
  return n.slice(0, 2).toUpperCase();
}
---

<BaseLayout
  title="All Heroes - Stats and Analysis | War Inc: Rising Wiki"
  description={`Browse all ${items.length} heroes in War Inc: Rising grouped by class. Compare HP, ATK, DEF, cost, rarity, and combat power. Find the best heroes for your team composition and game mode.`}
  currentSection="heroes"
>
  <style>
    .hero-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--space-3); }
    .hero-card { display: flex; gap: var(--space-3); padding: var(--space-3); background: var(--surface-card); border: 1px solid var(--border-light); border-radius: var(--radius-md); box-shadow: var(--shadow-xs), var(--bevel-outset); transition: all 150ms ease; align-items: center; text-decoration: none; color: inherit; }
    .hero-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-md), var(--bevel-outset); border-color: var(--gold-400); }
    .hero-card-body { flex: 1; min-width: 0; }
    .hero-card-name { font-family: var(--font-heading); font-size: var(--text-sm); font-weight: var(--weight-bold); color: var(--gold-700); }
    .hero-card-meta { font-size: var(--text-xs); color: #6c757d; display: flex; flex-wrap: wrap; gap: var(--space-1); margin-top: var(--space-1); }
    .class-section { margin-bottom: var(--space-8); }
    .class-section h2 { margin-top: 0; display: flex; align-items: center; gap: var(--space-2); }
    .class-desc { font-size: var(--text-sm); color: #6c757d; margin: 0 0 var(--space-3); font-family: var(--font-body); }
    .hero-count { font-family: var(--font-body); font-size: var(--text-sm); color: #6c757d; font-weight: var(--weight-normal); }
    .avatar { width: 56px; height: 56px; border-radius: var(--radius-md); flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-family: var(--font-heading); font-size: var(--text-lg); font-weight: var(--weight-bold); color: #fff; border: 1px solid var(--border-light); }
  </style>

  <h1>All Heroes</h1>
  <p>{items.length} playable units — grouped by class. <a href="/compare/">Compare units</a> side by side.</p>

  <nav class="section-nav" style="margin-bottom: var(--space-6);">
    <a href="/professions/">All Classes</a>
    <a href="/guides/best-low-cost-units/">Best Low Cost</a>
    <a href="/guides/best-mid-cost-units/">Best Mid Cost</a>
    <a href="/guides/best-high-cost-units/">Best High Cost</a>
    <a href="/compare/">Comparisons</a>
  </nav>

  {Object.entries(groups).map(([profession, heroes]) => (
    <section class="class-section">
      <h2 id={profession.toLowerCase()}>
        {profession}s
        <span class="hero-count">({heroes.length})</span>
      </h2>
      <p class="class-desc">{PROFESSION_DESC[profession]}</p>
      <div class="hero-grid">
        {heroes.map((hero) => {
          const initials = getInitials(hero.name);
          const rarityColors = { Common: '#6b7280', Rare: '#059669', Epic: '#2563eb', Legendary: '#7c3aed', Mythic: '#ea580c' };
          const bg = rarityColors[hero.rarity_name] || '#6b7280';
          return (
          <a href={`/heroes/${hero.slug}/`} class="hero-card">
            <div class="avatar" style="background: var(--surface-muted); color: var(--gold-600); font-size: var(--text-xl);">{initials}</div>
            <div class="hero-card-body">
              <div class="hero-card-name">{hero.name}</div>
              <div class="hero-card-meta">
                <span class="badge badge-rarity" data-level={hero.rarity_name === 'Common' ? 1 : hero.rarity_name === 'Rare' ? 2 : hero.rarity_name === 'Epic' ? 3 : hero.rarity_name === 'Legendary' ? 4 : hero.rarity_name === 'Mythic' ? 5 : 1}>
                  {hero.rarity_name}
                </span>
                {hero.cost ? <span class="stat-chip"><span class="stat-chip-label">Cost</span><span class="stat-chip-value">{hero.cost}</span></span> : null}
                {hero.combat_power ? <span class="stat-chip"><span class="stat-chip-label">Pow</span><span class="stat-chip-value">{hero.combat_power}</span></span> : null}
              </div>
            </div>
          </a>
          );
        })}
      </div>
    </section>
  ))}
</BaseLayout>
