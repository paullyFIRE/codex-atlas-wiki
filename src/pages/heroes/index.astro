---
import BaseLayout from '../../layouts/BaseLayout.astro';

const indexFiles = import.meta.glob('/data/pages/heroes/_index.json', { eager: true, import: 'default' });
const index = indexFiles['/data/pages/heroes/_index.json'] ?? { items: [], count: 0 };
const items = index.items ?? [];

const PROFESSION_ORDER = ['Tank', 'Warrior', 'Assassin', 'Mage', 'Support', 'Ranger', 'Special'];
const PROFESSION_DESC = {
  Tank: 'High HP and DEF. Absorbs damage, protects allies.',
  Warrior: 'Balanced melee fighters. Reliable damage and survivability.',
  Assassin: 'High single-target burst. Eliminates key threats.',
  Mage: 'Area magic damage. Effective against groups.',
  Support: 'Healing, buffs, and utility. Extends team survivability.',
  Ranger: 'Ranged physical damage. Safe distance attackers.',
  Special: 'Unique roles with situational strengths.',
};

const groups = {};
for (const p of PROFESSION_ORDER) {
  const members = items.filter(i => i.profession_name === p).sort((a, b) => (b.combat_power ?? 0) - (a.combat_power ?? 0));
  if (members.length > 0) groups[p] = members;
}

function getInitials(name) {
  const parts = name.trim().split(/\s+/);
  if (parts.length >= 2) return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
  const n = parts[0];
  if (n.length <= 1) return (n + '?').toUpperCase();
  return n.slice(0, 2).toUpperCase();
}

const rarityColors = { Common: 'bg-zinc-400', Rare: 'bg-emerald-600', Epic: 'bg-blue-600', Legendary: 'bg-purple-600', Mythic: 'bg-orange-600' };
---

<BaseLayout
  title="All Heroes - Stats and Analysis | War Inc: Rising Wiki"
  description={`Browse all ${items.length} heroes in War Inc: Rising grouped by class. Compare HP, ATK, DEF, cost, rarity, and combat power.`}
  currentSection="heroes"
>
  <nav class="flex items-center gap-2 text-label-md font-bold text-on-surface-variant mb-8 uppercase tracking-wider">
    <a href="/" class="hover:text-primary no-underline">Home</a>
    <span class="material-symbols-outlined text-xs">chevron_right</span>
    <span class="text-primary bg-primary-container/20 px-3 py-1 rounded-full">Heroes</span>
  </nav>
  <h1 class="font-display text-headline-lg text-on-surface mb-4 leading-none">All Heroes</h1>
  <p class="text-body-md text-on-surface-variant mb-8">{items.length} playable units — grouped by class. <a href="/compare/" class="text-secondary hover:underline">Compare units</a> side by side.</p>

  <div class="flex flex-wrap gap-3 mb-10">
    <a href="/professions/" class="bg-white border-2 border-outline-variant px-5 py-2.5 rounded-full text-label-md text-xs font-black uppercase tracking-widest text-on-surface hover:bg-surface-container-low transition-colors no-underline">All Classes</a>
    <a href="/guides/best-low-cost-units/" class="bg-white border-2 border-outline-variant px-5 py-2.5 rounded-full text-label-md text-xs font-black uppercase tracking-widest text-on-surface hover:bg-surface-container-low transition-colors no-underline">Best Low Cost</a>
    <a href="/guides/best-mid-cost-units/" class="bg-white border-2 border-outline-variant px-5 py-2.5 rounded-full text-label-md text-xs font-black uppercase tracking-widest text-on-surface hover:bg-surface-container-low transition-colors no-underline">Best Mid Cost</a>
    <a href="/guides/best-high-cost-units/" class="bg-white border-2 border-outline-variant px-5 py-2.5 rounded-full text-label-md text-xs font-black uppercase tracking-widest text-on-surface hover:bg-surface-container-low transition-colors no-underline">Best High Cost</a>
    <a href="/compare/" class="bg-white border-2 border-outline-variant px-5 py-2.5 rounded-full text-label-md text-xs font-black uppercase tracking-widest text-on-surface hover:bg-surface-container-low transition-colors no-underline">Comparisons</a>
  </div>

  {Object.entries(groups).map(([profession, heroes]) => (
    <section class="mb-12">
      <h2 id={profession.toLowerCase()} class="font-display text-title-md text-on-surface mb-2 flex items-center gap-2">
        {profession}s <span class="text-body-md text-on-surface-variant font-normal">({heroes.length})</span>
      </h2>
      <p class="text-body-md text-on-surface-variant mb-4">{PROFESSION_DESC[profession]}</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {heroes.map((hero) => {
          const initials = getInitials(hero.name);
          const rarityColor = rarityColors[hero.rarity_name] || 'bg-zinc-400';
          return (
          <a href={`/heroes/${hero.slug}/`} class="bg-white border-4 border-surface-container rounded-xl clash-card hover:border-primary transition-all group no-underline hover:-translate-y-1 flex items-center gap-4 p-4">
            <div class={`w-14 h-14 rounded-xl flex items-center justify-center text-white font-display font-bold text-lg flex-shrink-0 ${rarityColor}`}>
              {initials}
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="font-display text-title-md text-on-surface group-hover:text-primary transition-colors leading-tight">{hero.name}</h3>
              <div class="flex flex-wrap items-center gap-1 mt-1">
                <span class="inline-block px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-primary-container/20 text-on-primary-container border border-primary-container/30">{hero.rarity_name}</span>
                {hero.cost ? <span class="inline-block px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-surface-container text-on-surface-variant border border-outline-variant">Cost {hero.cost}</span> : null}
                {hero.combat_power ? <span class="inline-block px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-tertiary-container/20 text-on-tertiary-container border border-tertiary-container/30">Pow {hero.combat_power}</span> : null}
              </div>
            </div>
          </a>
          );
        })}
      </div>
    </section>
  ))}
</BaseLayout>
