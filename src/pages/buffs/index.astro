---
import BaseLayout from '../../layouts/BaseLayout.astro';

const files = import.meta.glob('/data/pages/buffs/_index.json', { eager: true, import: 'default' });
const index = files['/data/pages/buffs/_index.json'] ?? { items: [], count: 0 };
const items = index.items ?? [];
---

<BaseLayout
  title="Field Buffs - Battle Modifiers | War Inc: Rising"
  description={`Browse all ${items.length} field buffs in War Inc: Rising.`}
  currentSection="tools"
>
  <nav class="breadcrumb">
    <a href="/">Home</a>
    <span class="breadcrumb-sep">›</span>
    <span>Field Buffs</span>
  </nav>
  <h1>Field Buffs</h1>
  <p>{items.length} battle modifiers that affect gameplay.</p>
  <ul class="listing-grid">
    {items.map((item) => (
      <li><a href={`/buffs/${item.slug}/`} class="card card-pad-md card-hoverable" style="display:block;text-decoration:none;color:inherit;"><strong>{item.name}</strong></a></li>
    ))}
  </ul>
</BaseLayout>
