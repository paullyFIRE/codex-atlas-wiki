---
import { readFileSync } from 'fs';
import BaseLayout from '../../layouts/BaseLayout.astro';

const PROFESSION_MAP = {2: "Warrior", 3: "Tank", 4: "Assassin", 5: "Mage", 6: "Support", 7: "Ranger", 8: "Special"};

export async function getStaticPaths() {
  const pages = import.meta.glob('/data/pages/rarities/*.json', { eager: true, import: 'default' });
  const index = pages['/data/pages/rarities/_index.json'];
  const items = index?.items ?? [];
  return items.map((item) => ({
    params: { slug: item.slug },
    props: { slug: item.slug },
  }));
}

const { slug } = Astro.params;

const pages = import.meta.glob('/data/pages/rarities/*.json', { eager: true, import: 'default' });
const pageData = pages[`/data/pages/rarities/${slug}.json`];
if (!pageData) return Astro.redirect('/heroes/', 404);

function profName(id) {
  return PROFESSION_MAP[id] || "Unknown";
}
---

<BaseLayout title={pageData.title} description={pageData.meta_description} currentSection="heroes">
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://war-inc-rising.codex-atlas.com/" },
      { "@type": "ListItem", "position": 2, "name": "Heroes", "item": "https://war-inc-rising.codex-atlas.com/heroes/" },
      { "@type": "ListItem", "position": 3, "name": pageData.rarity_name + ' Units' }
    ]
  })} />
  <nav class="flex items-center gap-2 text-label-md font-bold text-on-surface-variant mb-8 uppercase tracking-wider">
    <a href="/" class="hover:text-primary no-underline">Home</a>
    <span class="material-symbols-outlined text-xs">chevron_right</span>
    <a href="/heroes/" class="hover:text-primary no-underline">Heroes</a>
    <span class="material-symbols-outlined text-xs">chevron_right</span>
    <span class="text-primary bg-primary-container/20 px-3 py-1 rounded-full">{pageData.rarity_name} Units</span>
  </nav>

  <article>
    <h1 class="font-display text-headline-lg text-on-surface mb-4 leading-none">{pageData.name}</h1>
    <p class="text-body-md text-on-surface-variant mb-8">All {pageData.units.length} {pageData.rarity_name} rarity units in War Inc: Rising, ranked by combat power.</p>

    <div class="table-wrap">
      <table class="wiki-table">
        <thead>
          <tr>
            <th>#</th>
            <th>Unit</th>
            <th>Class</th>
            <th>Cost</th>
            <th>Combat Power</th>
          </tr>
        </thead>
        <tbody>
          {pageData.units.map((u, i) => (
            <tr>
              <td><strong>{i + 1}</strong></td>
              <td><a href={`/heroes/${u.slug}/`}>{u.name}</a></td>
              <td><a href={`/professions/${(profName(u.profession)).toLowerCase()}/`}>{profName(u.profession)}</a></td>
              <td>{u.cost}</td>
              <td data-type="number">{u.combat_power}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p style="margin-top: var(--space-4);">
      <a href="/heroes/">Browse all heroes</a> · <a href="/professions/">View by profession</a>
      · <a href="/tier-lists/">View tier lists</a>
    </p>
  </article>
</BaseLayout>
