---
const files = import.meta.glob('/data/pages/compare/_index.json', { eager: true, import: 'default' });
const index = files['/data/pages/compare/_index.json'] ?? { items: [], count: 0 };
const first = index?.items?.[0];
const url = first ? `/compare/${first.slug}/` : '/heroes/';
const refresh = `0; url=${url}`;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="refresh" content={refresh}>
  <title>Redirecting...</title>
</head>
<body>
  <p>Redirecting to <a href={url}>{url}</a></p>
</body>
</html>
