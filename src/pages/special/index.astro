---
import BaseLayout from '../../layouts/BaseLayout.astro';

const files = import.meta.glob('/data/pages/special/_index.json', { eager: true, import: 'default' });
const index = files['/data/pages/special/_index.json'] ?? { items: [], count: 0 };
const items = index.items ?? [];
---

<BaseLayout
  title="All Special Entities - Stats | War Inc: Rising Wiki"
  description={`Browse all ${items.length} special entities in War Inc: Rising.`}
  currentSection="buildings"
>
  <nav class="breadcrumb">
    <a href="/">Home</a>
    <span class="breadcrumb-sep">›</span>
    <span>Special Entities</span>
  </nav>
  <h1>All Special Entities</h1>
  <p>{items.length} resource buildings, mines, barracks, and more.</p>
  <ul class="listing-grid">
    {items.sort((a, b) => b.combat_power - a.combat_power).map((item) => (
      <li><a href={`/special/${item.slug}/`} class="card card-pad-md card-hoverable" style="display:block;text-decoration:none;color:inherit;"><strong>{item.name}</strong></a></li>
    ))}
  </ul>
</BaseLayout>
