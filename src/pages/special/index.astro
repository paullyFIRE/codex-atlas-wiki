---
import BaseLayout from '../../layouts/BaseLayout.astro';

const files = import.meta.glob('/data/pages/special/_index.json', { eager: true, import: 'default' });
const index = files['/data/pages/special/_index.json'] ?? { items: [], count: 0 };
const items = index.items ?? [];
---

<BaseLayout
  title="All Special Entities - Stats | War Inc: Rising Wiki"
  description={`Browse all ${items.length} special entities in War Inc: Rising.`}
  currentSection="buildings"
>
  <nav class="flex items-center gap-2 text-label-md font-bold text-on-surface-variant mb-8 uppercase tracking-wider">
    <a href="/" class="hover:text-primary no-underline">Home</a>
    <span class="material-symbols-outlined text-xs">chevron_right</span>
    <span class="text-primary bg-primary-container/20 px-3 py-1 rounded-full">Special Entities</span>
  </nav>
  <h1 class="font-display text-headline-lg text-on-surface mb-4 leading-none">All Special Entities</h1>
  <p class="text-body-md text-on-surface-variant mb-8">{items.length} resource buildings, mines, barracks, and more.</p>
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
    {items.sort((a, b) => b.combat_power - a.combat_power).map((item) => (
      <a href={`/special/${item.slug}/`} class="bg-white border-4 border-surface-container rounded-xl p-6 clash-card hover:border-primary transition-all group no-underline hover:-translate-y-1 block">
        <h2 class="text-title-md font-display text-on-surface group-hover:text-primary transition-colors">{item.name}</h2>
      </a>
    ))}
  </div>
</BaseLayout>
