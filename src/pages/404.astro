    .e404 { text-align: center; padding: 3rem 1rem; }
    .e404 h1 { font-size: 3rem; margin-bottom: 0.5rem; }
    .e404 p { font-size: 1.1rem; color: #6c757d; margin-bottom: 1.5rem; }
    .e404 a { display: inline-block; margin: 0.25rem 0.5rem; }
  </style>
  <div class="e404">
    <h1>404</h1>
    <p>Page not found. The war continues elsewhere.</p>
    <p>
      <a href="/">Home</a>
      <a href="/heroes/">Heroes</a>
      <a href="/buildings/">Buildings</a>
      <a href="/equipment/">Equipment</a>
      <a href="/tools/">Tools</a>
    </p>
  </div>
</BaseLayout>
