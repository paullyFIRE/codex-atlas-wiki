---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found — War Inc: Rising">
  <div style="text-align: center; padding: 4rem 1rem;">
    <h1 style="font-size: 3rem; margin-bottom: 0.5rem;">404</h1>
    <p style="font-size: 1.1rem; color: #6c757d; margin-bottom: 1.5rem;">Page not found. The war continues elsewhere.</p>
    <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
      <a href="/" class="btn btn-primary">Home</a>
      <a href="/heroes/" class="btn btn-secondary">Heroes</a>
      <a href="/buildings/" class="btn btn-secondary">Buildings</a>
      <a href="/tools/" class="btn btn-secondary">Tools</a>
    </div>
  </div>
</BaseLayout>
