---
import { readFileSync } from 'fs';
import BaseLayout from '../../layouts/BaseLayout.astro';

const hf = import.meta.glob('/data/pages/heroes/_index.json', { eager: true, import: 'default' });
const heroCount = hf['/data/pages/heroes/_index.json']?.count ?? 0;

const index = JSON.parse(readFileSync('data/pages/guides/_index.json', 'utf-8'));
const items = index.items ?? [];

function loadGuide(slug) {
  try {
    return JSON.parse(readFileSync(`data/pages/guides/${slug}.json`, 'utf-8'));
  } catch { return null; }
}

const guides = items.map(item => {
  const guide = loadGuide(item.slug);
  const units = guide?.units || [];
  const top3 = units.slice(0, 3).map(u => u.name).join(', ');
  let desc = '';
  if (item.slug.includes('cost')) desc = `Top units costing ${guide?.cost_label || ''} — ${top3}`;
  else if (item.slug.includes('mode')) desc = `Best heroes for ${item.name.replace('Best Heroes for ', '')} — ${top3}`;
  else desc = `Top ${item.name.toLowerCase()} — ${top3}`;
  return { slug: item.slug, name: item.name, desc, unitCount: units.length };
});
---

<BaseLayout
  title="War Inc: Rising Hero Guides by Cost and Game Mode"
  description="Find the best heroes for your War Inc: Rising strategy. Cost-based and mode-based hero recommendations ranked by combat power from extracted game data."
  currentSection="guides"
>
  <nav class="flex items-center gap-2 text-label-md font-bold text-on-surface-variant mb-8 uppercase tracking-wider">
    <a href="/" class="hover:text-primary no-underline">Home</a>
    <span class="material-symbols-outlined text-xs">chevron_right</span>
    <span class="text-primary bg-primary-container/20 px-3 py-1 rounded-full">Strategy Guides</span>
  </nav>
  <h1 class="font-display text-headline-lg text-on-surface mb-4 leading-none">Strategy Guides</h1>
  <p class="text-body-md text-on-surface-variant mb-8">Data-driven guides to help you choose the best heroes. Also check <a href="/professions/" class="text-secondary hover:underline">profession rankings</a>, <a href="/compare/" class="text-secondary hover:underline">hero comparisons</a>, and <a href="/tools/" class="text-secondary hover:underline">tools</a>.</p>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {guides.map((g) => (
      <a href={`/guides/${g.slug}/`} class="bg-white border-4 border-surface-container rounded-xl p-8 clash-card hover:border-primary transition-all group no-underline hover:-translate-y-1 block">
        <h2 class="text-title-md font-display text-on-surface group-hover:text-primary transition-colors">{g.name}</h2>
        <p class="text-body-md text-on-surface-variant mt-3">{g.desc} ({g.unitCount} units)</p>
        <span class="flex items-center gap-2 text-label-md font-bold text-primary mt-4">
          View Guide <span class="material-symbols-outlined text-sm opacity-0 group-hover:opacity-100 transition-all group-hover:translate-x-1">arrow_forward</span>
        </span>
      </a>
    ))}
  </div>

  <p class="text-body-md text-on-surface-variant mt-10">
    <a href="/heroes/" class="text-secondary hover:underline">Browse all {heroCount} heroes</a> · <a href="/tools/" class="text-secondary hover:underline">Tools & Calculators</a>
  </p>
</BaseLayout>
