---
import { readFileSync } from 'fs';
import BaseLayout from '../layouts/BaseLayout.astro';

const db = JSON.parse(readFileSync('data/processed/unit_database.json', 'utf-8'));
const nm = JSON.parse(readFileSync('data/processed/unit_name_map.json', 'utf-8'));
const rawSyn = JSON.parse(readFileSync('data/processed/config/battle_synergy.json', 'utf-8'));

const units = Object.entries(db)
  .filter(([_, u]) => u.unit_type === 1)
  .map(([id, u]) => ({
    id: u.id,
    name: nm[id] || u.name_en || `Unit ${id}`,
    rarity: u.rarity ?? 0,
    profession: u.profession ?? 0,
    cost: u.cost ?? 0,
    power: u.combat_power ?? 0,
    hp: u.stats?.["1"]?.["1050"] ?? 0,
    atk: u.stats?.["1"]?.["1070"] ?? 0,
    def: u.stats?.["1"]?.["1080"] ?? 0,
  }));

const rarityNames = { 1: "Common", 2: "Rare", 3: "Epic", 4: "Legendary", 5: "Mythic" };
const profNames = { 2: "Warrior", 3: "Tank", 4: "Assassin", 5: "Mage", 6: "Support", 7: "Ranger", 8: "Special" };
const rarityColors = { 1: "#6c757d", 2: "#2e7d32", 3: "#1565c0", 4: "#7b1fa2", 5: "#e65100" };

const synergyMap = {};
const synLibs = rawSyn.libs || {};
for (const lib of Object.values(synLibs)) {
  for (const lb of lib.layBuffs || []) {
    for (const lvcfg of lb.lvConfig || []) {
      for (const cond of lvcfg.conds || []) {
        if (cond.condType === 1 && cond.options) {
          for (const opt of cond.options) {
            if (!synergyMap[opt]) synergyMap[opt] = [];
            if (!synergyMap[opt].includes(lb.remark)) synergyMap[opt].push(lb.remark);
          }
        }
      }
    }
  }
}

const dataPayload = { units, synergies: synergyMap, rarityNames, profNames, rarityColors };
---

<BaseLayout title="Team Builder — Build Your Formation | War Inc: Rising Wiki"
  description="Interactive team builder for War Inc: Rising. Browse heroes, build formations, and discover team synergies.">

  <script id="app-data" type="application/json" set:html={JSON.stringify(dataPayload)}></script>

  <style>
    .tb-wrap { display: flex; gap: 1.5rem; flex-wrap: wrap; }
    .tb-pool { flex: 2; min-width: 300px; }
    .tb-team { flex: 1; min-width: 280px; }
    .tb-search { width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px; font-size: 1rem; margin-bottom: 0.5rem; }
    .tb-filters { display: flex; gap: 0.5rem; margin-bottom: 0.75rem; flex-wrap: wrap; }
    .tb-filters select { padding: 0.3rem; border: 1px solid #ccc; border-radius: 3px; }
    .tb-unit { display: flex; align-items: center; gap: 0.5rem; padding: 0.4rem 0.6rem; border: 1px solid #eee; border-radius: 4px; cursor: pointer; transition: background 0.15s; margin-bottom: 2px; }
    .tb-unit:hover { background: #e9ecef; }
    .tb-unit .r-badge { display: inline-block; padding: 0.1rem 0.4rem; border-radius: 3px; font-size: 0.7rem; color: #fff; font-weight: 600; min-width: 3.5rem; text-align: center; }
    .tb-unit .prof { font-size: 0.8rem; color: #6c757d; }
    .tb-unit .power { font-size: 0.8rem; color: #6c757d; margin-left: auto; }
    .tb-slot { display: flex; align-items: center; gap: 0.5rem; padding: 0.6rem; border: 2px dashed #ccc; border-radius: 6px; margin-bottom: 4px; min-height: 2.5rem; background: #f8f9fa; }
    .tb-slot.f { border-style: solid; background: #fff; }
    .tb-slot .rm { margin-left: auto; cursor: pointer; color: #e94560; font-weight: bold; background: none; border: none; font-size: 1.1rem; }
    .tb-syn-tag { display: inline-block; padding: 0.2rem 0.5rem; background: #e3f2fd; color: #1565c0; border-radius: 4px; font-size: 0.8rem; margin: 0.2rem; }
    .tb-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; margin: 1rem 0; }
    .tb-stat { background: #f8f9fa; padding: 0.5rem; border-radius: 4px; text-align: center; }
    .tb-stat .v { font-size: 1.3rem; font-weight: 700; color: #1a1a2e; }
    .tb-stat .l { font-size: 0.75rem; color: #6c757d; text-transform: uppercase; }
    .tb-empty { color: #6c757d; font-style: italic; padding: 0.5rem; }
    .tb-list { max-height: 70vh; overflow-y: auto; }
  </style>

  <h1>Team Builder</h1>
  <p>Build your formation by selecting heroes. Discover synergies and see your team's total power.</p>

  <div class="tb-wrap">
    <div class="tb-pool">
      <input type="text" class="tb-search" id="q" placeholder="Search heroes..." oninput="R()">
      <div class="tb-filters">
        <select id="fr" onchange="R()"><option value="">All Rarities</option><option value="1">Common</option><option value="2">Rare</option><option value="3">Epic</option><option value="4">Legendary</option><option value="5">Mythic</option></select>
        <select id="fp" onchange="R()"><option value="">All Classes</option><option value="2">Warrior</option><option value="3">Tank</option><option value="4">Assassin</option><option value="5">Mage</option><option value="6">Support</option><option value="7">Ranger</option></select>
      </div>
      <div class="tb-list" id="L"></div>
    </div>

    <div class="tb-team">
      <h2>Formation (<span id="sc">0</span>/8)</h2>
      <div id="T"></div>
      <div class="tb-stats">
        <div class="tb-stat"><div class="v" id="tp">0</div><div class="l">Total Power</div></div>
        <div class="tb-stat"><div class="v" id="tc">0</div><div class="l">Total Cost</div></div>
        <div class="tb-stat"><div class="v" id="th">0</div><div class="l">Avg HP</div></div>
        <div class="tb-stat"><div class="v" id="ta">0</div><div class="l">Avg ATK</div></div>
      </div>
      <h3>Active Synergies</h3>
      <div id="S"><span class="tb-empty">Add units to see synergies</span></div>
    </div>
  </div>

  <script>
  const D = JSON.parse(document.getElementById('app-data').textContent);
  const U = D.units, SY = D.synergies, RN = D.rarityNames, PN = D.profNames, RC = D.rarityColors;
  let tm = [];

  function R() {
    const q = document.getElementById('q').value.toLowerCase();
    const fr = document.getElementById('fr').value;
    const fp = document.getElementById('fp').value;
    const inTm = new Set(tm.map(u => u.id));
    const f = U.filter(u =>
      u.name.toLowerCase().includes(q) &&
      (!fr || u.rarity === +fr) &&
      (!fp || u.profession === +fp)
    );
    document.getElementById('L').innerHTML = f.map(u => {
      const taken = inTm.has(u.id);
      return `<div class="tb-unit" onclick="${taken ? '' : 'A(' + u.id + ')'}" style="opacity:${taken ? .4 : 1}">
        <span class="r-badge" style="background:${RC[u.rarity]||'#6c757d'}">${RN[u.rarity]||'?'}</span>
        <strong>${u.name}</strong>
        <span class="prof">${PN[u.profession]||'?'}</span>
        <span class="power">⚡${u.power}</span>
      </div>`;
    }).join('');
  }

  function A(id) {
    if (tm.length >= 8) return;
    const u = U.find(x => x.id === id);
    if (!u || tm.some(x => x.id === id)) return;
    tm.push(u);
    T(); R();
  }

  function Rm(id) {
    tm = tm.filter(u => u.id !== id);
    T(); R();
  }

  function T() {
    document.getElementById('sc').textContent = tm.length;
    document.getElementById('T').innerHTML = Array.from({length: 8}, (_, i) => {
      const u = tm[i];
      if (!u) return `<div class="tb-slot"><span class="tb-empty">Slot ${i+1}</span></div>`;
      return `<div class="tb-slot f">
        <span class="r-badge" style="background:${RC[u.rarity]||'#6c757d'}">${RN[u.rarity]||'?'}</span>
        <strong>${u.name}</strong>
        <span class="prof">${PN[u.profession]||'?'}</span>
        <button class="rm" onclick="Rm(${u.id})">✕</button>
      </div>`;
    }).join('');

    document.getElementById('tp').textContent = tm.reduce((a, b) => a + (b.power||0), 0);
    document.getElementById('tc').textContent = tm.reduce((a, b) => a + (b.cost||0), 0);
    const n = tm.length || 1;
    document.getElementById('th').textContent = Math.round(tm.reduce((a, b) => a + (b.hp||0), 0) / n);
    document.getElementById('ta').textContent = Math.round(tm.reduce((a, b) => a + (b.atk||0), 0) / n);

    const as = new Set();
    tm.forEach(u => { (SY[u.id]||[]).forEach(s => as.add(s)); });
    const el = document.getElementById('S');
    if (as.size === 0) el.innerHTML = '<span class="tb-empty">No synergies active</span>';
    else el.innerHTML = [...as].map(s => `<span class="tb-syn-tag">${s}</span>`).join('');
  }

  R(); T();
  </script>
</BaseLayout>
