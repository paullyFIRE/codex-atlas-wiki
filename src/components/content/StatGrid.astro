---
export interface StatItem {
  label: string;
  value: string | number;
  change?: string;
  direction?: 'up' | 'down';
}

export interface Props {
  items: StatItem[];
  columns?: number;
}

const { items, columns } = Astro.props;
const style = columns ? `grid-template-columns: repeat(${columns}, 1fr)` : undefined;
---

<div class="stat-grid" style={style}>
  {items.map((item) => (
    <div class="stat-item">
      <div class="stat-label">{item.label}</div>
      <div class="stat-value">{item.value}</div>
      {item.change && (
        <div class="stat-change" data-direction={item.direction || (item.change.startsWith('+') ? 'up' : 'down')}>
          {item.change}
        </div>
      )}
    </div>
  ))}
</div>
