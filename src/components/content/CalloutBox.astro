---
export interface Props {
  type: 'info' | 'warning' | 'lore' | 'critical';
  title: string;
  icon?: string;
}

const { type, title, icon } = Astro.props;
const icons: Record<string, string> = {
  info: 'ℹ',
  warning: '⚠',
  lore: '◆',
  critical: '✕',
};
---

<div class="callout" data-type={type} role="alert">
  <span class="callout-icon" aria-hidden="true">{icon || icons[type]}</span>
  <div>
    <div class="callout-title">{title}</div>
    <div><slot /></div>
  </div>
</div>
